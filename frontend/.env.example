# 环境变量示例文件（可安全提交到仓库）
# 复制为 .env.production 或 .env.development 后按需填写

# API 基地址：Nginx 同域反代时保持 /api；独立部署时填后端公网地址
VITE_API_BASE=/api

# 页面标题
VITE_APP_TITLE=CarbonAI V6.0 · 时空智能碳管理平台

# 实时监测 SSE：生产接入真实服务时填写完整 HTTPS 地址；未接入则留空
VITE_MONITORING_SSE_URL=

# ICP 备案号（工信部签发，示例：粤ICP备2026140571号）
VITE_ICP_BEIAN=

# 公安联网备案号（如已办理则填，未办理留空）
VITE_POLICE_BEIAN=
