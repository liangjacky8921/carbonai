# CarbonAI V6.0 后端生产环境变量示例
# 复制到部署平台的 Secret/Environment 设置中，不要把真实密钥写回仓库。

APP_ENV=production
ALLOW_ORIGINS=https://carbontool.cn,https://www.carbontool.cn

# 至少 32 个字符；可用 openssl rand -hex 32 生成
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TOKEN_TTL_SECONDS=86400

# 生产环境必须使用持久化数据库。SQLite 仅适合挂载了持久磁盘的单机部署。
DATABASE_URL=mysql+pymysql://user:password@host:3306/carbonai?charset=utf8mb4

# 注册邮件，可留空以关闭真实邮件发送
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_BACKUP_HOST=
SMTP_BACKUP_PORT=465
SMTP_BACKUP_USER=
SMTP_BACKUP_PASS=
SMTP_BACKUP_FROM=

# AI 顾问，可留空并使用前端本地知识库回退
AI_API_BASE=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
# 上游单次socket超时上限20秒；前端聊天等待65秒，无自动重试。
AI_TIMEOUT=20
# 默认禁用。仅经人工确认单进程/单实例受控运行时改为single-process及true。
# 多worker/多实例不支持共享额度，必须保持disabled；不能视为货币预算。
AI_DEPLOYMENT_MODE=disabled
AI_SINGLE_PROCESS_CONFIRMED=false
AI_INSTANCE_COUNT=1
AI_USER_REQUESTS_PER_MINUTE=3
AI_GLOBAL_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT=2
AI_USER_DAILY_CALLS=20
AI_GLOBAL_DAILY_CALLS=100
AI_DUPLICATE_WINDOW_SECONDS=10
# UTC日界限；进程重启清零。无共享持久预算，多worker不能安全放行。
AI_MAX_BODY_BYTES=32768
AI_MAX_QUESTION_CHARS=2000
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_HISTORY_ITEM_CHARS=2000
AI_MAX_HISTORY_CHARS=8000
AI_MAX_RESPONSE_BYTES=65536
AI_MAX_OUTPUT_TOKENS=1500
# 限额必须为正整数（有代码硬上限）；错配关闭调用，不接受无限制值。
