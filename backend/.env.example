# CarbonAI V6.0 后端生产环境变量示例
# 复制到部署平台的 Secret/Environment 设置中，不要把真实密钥写回仓库。

APP_ENV=production
ALLOW_ORIGINS=https://carbontool.cn,https://www.carbontool.cn

# 至少 32 个字符；可用 openssl rand -hex 32 生成
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TOKEN_TTL_SECONDS=86400

# 生产环境必须使用持久化数据库。SQLite 仅适合挂载了持久磁盘的单机部署。
DATABASE_URL=mysql+pymysql://user:password@host:3306/carbonai?charset=utf8mb4

# 注册邮件，可留空以关闭真实邮件发送
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_BACKUP_HOST=
SMTP_BACKUP_PORT=465
SMTP_BACKUP_USER=
SMTP_BACKUP_PASS=
SMTP_BACKUP_FROM=

# AI 顾问，可留空并使用前端本地知识库回退
AI_API_BASE=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=60
